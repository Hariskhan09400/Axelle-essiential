# Axelle Sentinel — Frontend environment variables
# Copy to .env for local development. Values below are placeholders.

AXELLE_MODE=demo
FLASK_ENV=development
CORS_ORIGINS=http://localhost:5173
WAZUH_URL=https://wazuh.example.local:55000
WAZUH_USER=replace-with-wazuh-user
WAZUH_PASSWORD=replace-with-wazuh-password
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
TELEGRAM_CHAT_ID=replace-with-telegram-chat-id

VITE_API_URL=http://localhost:5000/api
