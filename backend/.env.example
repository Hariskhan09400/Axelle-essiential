# Axelle Sentinel — Backend environment configuration
# Copy this file to .env and adjust values as needed.

# Operating mode: "demo" (mock data) or "live" (authenticated event ingest)
AXELLE_MODE=live
INGEST_API_KEY=change-me-long-random-secret

# Flask
FLASK_ENV=development
FLASK_PORT=5000

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Wazuh SIEM (placeholders only — Phase 3)
WAZUH_URL=https://wazuh.example.local:55000
WAZUH_USER=wazuh-api-user
WAZUH_USER=replace-with-wazuh-user
WAZUH_PASSWORD=replace-with-wazuh-password

# Telegram alerts (placeholders only — Phase 5)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-chat-id
