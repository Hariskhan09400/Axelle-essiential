# Root project environment variables
# Copy as .env in local development, or add these in Vercel project settings.

# Flask backend
AXELLE_MODE=demo
FLASK_ENV=development
FLASK_PORT=5000
CORS_ORIGINS=http://localhost:5173
WAZUH_URL=https://wazuh.example.local:55000
WAZUH_USER=replace-with-wazuh-user
WAZUH_PASSWORD=replace-with-wazuh-password
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
TELEGRAM_CHAT_ID=replace-with-telegram-chat-id

# Frontend (same origin on Vercel — leave as /api)
VITE_API_URL=/api

# After deploy, add your Vercel URL to CORS_ORIGINS if the UI and API
# are ever on different domains. Same-project deploy does not need this.
