# Local development: copy to .env. Vercel uses the same origin for frontend and API.
# Set AXELLE_MODE=demo for mock data or live to accept authenticated events.

# Flask backend
AXELLE_MODE=live
INGEST_API_KEY=change-me-long-random-secret
FLASK_ENV=development
FLASK_PORT=5000
CORS_ORIGINS=http://localhost:5173
WAZUH_URL=https://wazuh.example.local:55000
WAZUH_USER=replace-with-wazuh-user
WAZUH_PASSWORD=replace-with-wazuh-password
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
TELEGRAM_CHAT_ID=replace-with-telegram-chat-id

# Relative path works on localhost, LAN IPs, and the same-project Vercel deployment.
VITE_API_URL=/api

# After deploy, add your Vercel URL to CORS_ORIGINS if the UI and API
# are ever on different domains. Same-project deploy does not need this.
